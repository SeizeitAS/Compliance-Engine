{
  "name": "compliance-engine",
  "version": "0.1.0",
  "description": "Zero-knowledge compliance engine for MiCA, AMLR and Norwegian AML law on Midnight",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "time:report": "node scripts/time-report.ts docs/time/timelog.csv",
    "vectors": "node scripts/gen-vectors.ts > test/vectors/nonmembership-vectors.json",
    "contracts:compile": "scripts/compile-contracts.sh",
    "crosscheck:circuit": "node scripts/crosscheck-circuit.mjs",
    "crosscheck:hashes": "node scripts/crosscheck-hashes.mjs"
  },
