// AML sanctions gate: zero-knowledge NON-MEMBERSHIP proof against a sorted Merkle tree.
//
// STATUS: DRAFT v2, COMPILED 2026-11-16 (CE-5: compiler 0.31.0, language 0.23.0; hashes cross-checked).
// Rewritten in the syntax used by contracts that really compile
// (flat file, `import CompactStandardLibrary`, `export pure circuit`, `witness`, `Counter`,
// `Set`, `disclose`, `pad`, `x as Field as Bytes<32>`, `for (const i of 0..n)`), taken from
// OpenZeppelin Compact Contracts 0.4.0 and the compiled krypto_aml contract in the Business 20
// repository (compiler 0.31.0, language 0.23.0). Re-run `npm run contracts:compile`
// and `npm run crosscheck:circuit` after any change (see docs/toolchain.md).
// Proving and a node are untested.
//
// Algorithm and tests: src/sanctions/indexedMerkleTree.ts. Keep both in lock-step:
//   KEY_BITS = 128, depth = 20, hash layout H(tag32 || a32 || b32), numbers little-endian.
//
// Scheme: sanctioned keys are sorted k_1 < ... < k_n. Leaf i commits to the gap (lo_i, hi_i)
// between adjacent keys, with sentinels 0 and 2^128 - 1. A key x is NOT listed iff some committed
// leaf has lo < x < hi. The subject key, range and Merkle path stay private witnesses.
//
// Verified on the real compiler: language_version >= 0.23.0 is accepted; persistentHash over
// Vector<3, Bytes<32>> equals SHA-256 of the concatenation; `Uint<128> as Field as Bytes<32>` is
// little-endian. `let` is reserved, so the Merkle path walk uses `fold` instead of a mutable loop.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

// ---- public state -----------------------------------------------------------------------------
export ledger sanctions_root: Bytes<32>;
export ledger list_version: Counter;
export ledger admin_commitment: Bytes<32>;
export ledger receipts: Set<Bytes<32>>; // opaque screening receipts, contain no personal data

// ---- private inputs (supplied by the prover's local environment only) -------------------------
witness wit_subject_key(): Uint<128>;   // first 128 bits of SHA-256(domain || normalised identifier)
witness wit_range_lo(): Uint<128>;
witness wit_range_hi(): Uint<128>;
witness wit_path_siblings(): Vector<20, Bytes<32>>;
witness wit_path_is_right(): Vector<20, Boolean>;  // true: the running node is the right child
witness wit_receipt_nonce(): Bytes<32>;
witness wit_admin_secret(): Bytes<32>;

constructor(initial_root: Bytes<32>, admin: Bytes<32>) {
  sanctions_root = disclose(initial_root);
  admin_commitment = disclose(admin);
  list_version.increment(1);
}

// ---- hashing (pure, exported so they can be tested without a proof or a node) -----------------
export pure circuit hash_leaf(lo: Uint<128>, hi: Uint<128>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "ce.leaf.v1"), lo as Field as Bytes<32>, hi as Field as Bytes<32>]
  );
}

export pure circuit hash_node(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "ce.node.v1"), left, right]);
}

// One Merkle step. Compact has no mutable locals (`let` is reserved), so the path walk is a fold.
pure circuit merkle_step(node: Bytes<32>, sibling: Bytes<32>, is_right: Boolean): Bytes<32> {
  return is_right ? hash_node(sibling, node) : hash_node(node, sibling);
}

export pure circuit compute_root(
  leaf: Bytes<32>,
  siblings: Vector<20, Bytes<32>>,
  is_right: Vector<20, Boolean>
): Bytes<32> {
  return fold(merkle_step, leaf, siblings, is_right);
}

// ---- screening --------------------------------------------------------------------------------
// Prove that the private subject key is NOT on the sanctions list committed to on-chain.
// Records an opaque receipt so the screening is auditable without revealing the subject.
//
// CE-9 will replace `wit_subject_key` with a key derived inside the circuit from an issuer-signed
// EUDI credential (see docs/eudi-intake.md). Until then the key is prover-asserted.
export circuit prove_not_sanctioned(): Bytes<32> {
  const x = wit_subject_key();
  const lo = wit_range_lo();
  const hi = wit_range_hi();

  // Strict inequalities: a listed key is always an endpoint of some range, never interior, so it
  // can never satisfy both.
  assert(x > 0, "key must be non-zero");
  assert(lo < x, "key must be above range start");
  assert(x < hi, "key must be below range end");

  // The range leaf must be part of the CURRENT on-chain sanctions tree.
  const root = compute_root(hash_leaf(lo, hi), wit_path_siblings(), wit_path_is_right());
  assert(root == sanctions_root, "range is not in the committed sanctions list");

  // The receipt binds the screening to the list version and a private nonce. The subject can
  // later open it to an auditor by revealing the nonce.
  const receipt = persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "ce.receipt.v1"), wit_receipt_nonce(), list_version as Field as Bytes<32>, x as Field as Bytes<32>]
  );
  receipts.insert(disclose(receipt));
  return disclose(receipt);
}

// Publish a new sanctions list root, for example after an official list update.
// Single-admin governance is a placeholder: production needs multi-party control (CE-15).
export circuit update_sanctions_root(new_root: Bytes<32>): [] {
  const caller = persistentHash<Vector<2, Bytes<32>>>([pad(32, "ce.admin.v1"), wit_admin_secret()]);
  assert(caller == admin_commitment, "not authorised");
  sanctions_root = disclose(new_root);
  list_version.increment(1);
}
